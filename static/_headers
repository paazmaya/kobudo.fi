# Security headers
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.clarity.ms https://*.clarity.ms; connect-src 'self' https://www.clarity.ms https://*.clarity.ms; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Timing-Allow-Origin: *

# Cache control for hashed bundle assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache control for static images
/img/*
  Cache-Control: public, max-age=604800

# Cache control for HTML pages
/*.html
  Cache-Control: public, max-age=0, must-revalidate
